#if defined(POPS_TEST_OWNED_HISTORY) || defined(POPS_TEST_MIXED_NORM) || \
    defined(POPS_TEST_MIXED_CFL) || defined(POPS_TEST_DECLARED_SUBCYCLING)
namespace pops::runtime::program::detail {
template <int Dim>
struct AmrInteractionHistorySnapshotTestAccess {
  using Context = AmrProgramContext<Dim>;
  static bool owns(const Context& context, const pops::AmrSystem<Dim>* system) {
    return context.facade_ == system;
  }
  static std::uint64_t generation(const Context& context) {
    return context.runtime_state().step_install_generation_;
  }
  static bool artifact_backed(const Context& context) {
    return context.runtime_state().artifact_backed_;
  }
};
}  // namespace pops::runtime::program::detail

namespace {
constexpr int dim = pops::kNativeDimension;
using ControlledSystem = pops::AmrSystem<dim>;
using ControlledContext = pops::runtime::program::AmrProgramContext<dim>;
using ControlAccess = pops::runtime::program::detail::AmrInteractionHistorySnapshotTestAccess<dim>;
struct ContextControl {
  std::weak_ptr<ControlledContext> context;
  std::uint64_t generation;
  std::weak_ptr<int> invocations{};
#if defined(POPS_TEST_DECLARED_SUBCYCLING)
  std::weak_ptr<std::vector<std::tuple<int, double, double>>> visits{};
#endif
};
std::unordered_map<ControlledSystem*, ContextControl> installed_contexts;

std::shared_ptr<ControlledContext> require_fixture_context(ControlledSystem* system) {
  const auto found = installed_contexts.find(system);
  if (found == installed_contexts.end())
    throw std::logic_error("fixture control lacks its exact installed system");
  auto context = found->second.context.lock();
  if (!context || !ControlAccess::owns(*context, system) ||
      ControlAccess::generation(*context) != found->second.generation ||
      system->installed_program_hash() != pops_program_hash() ||
      !ControlAccess::artifact_backed(*context))
    throw std::logic_error("fixture control lost its authenticated installed context");
  return context;
}
}  // namespace

#if defined(POPS_TEST_DECLARED_SUBCYCLING)
extern "C" void pops_test_declared_subcycling_visits(
    ControlledSystem* system, std::vector<std::tuple<int, double, double>>* result) {
  const auto context = require_fixture_context(system);
  const auto visits = installed_contexts.at(system).visits.lock();
  if (!visits)
    throw std::logic_error("subcycling fixture lost its installed visits");
  *result = *visits;
}
#elif defined(POPS_TEST_MIXED_CFL)
extern "C" int pops_test_mixed_cfl_invocations(ControlledSystem* system) {
  const auto context = require_fixture_context(system);
  const auto calls = installed_contexts.at(system).invocations.lock();
  if (!calls)
    throw std::logic_error("CFL fixture lost its installed invocation counter");
  return *calls;
}
#elif defined(POPS_TEST_MIXED_NORM)
extern "C" void pops_test_mixed_norm_context(ControlledSystem* system,
                                             std::shared_ptr<ControlledContext>* result) {
  *result = require_fixture_context(system);
}
#else
extern "C" void pops_test_history_context(ControlledSystem* system,
                                          std::shared_ptr<ControlledContext>* result) {
  *result = require_fixture_context(system);
}
#endif
#endif

extern "C" void pops_install_program_amr(pops::AmrSystem<pops::kNativeDimension>* system) {
  const auto context = pops::runtime::program::make_program_execution_provider(system);
  context->configure_primary_clock(primary_clock);
#if defined(POPS_TEST_PREPARED_CONSTITUTIVE_AMR)
  pops::test::install_prepared_constitutive_step(context);
#elif defined(POPS_TEST_EMPTY_AMR_CADENCE) || defined(POPS_TEST_MIXED_NORM)
  context->install([](double) {}, context);
#elif defined(POPS_TEST_DECLARED_SUBCYCLING)
  context->declare_clock_relation(primary_clock, POPS_TEST_EULER_FINE_CLOCK, 2);
  context->declare_clock_relation(POPS_TEST_EULER_FINE_CLOCK, POPS_TEST_EULER_SECOND_FINE_CLOCK, 2);
  using Visit = std::tuple<int, double, double>;
  const auto visits = std::make_shared<std::vector<Visit>>();
  visits->reserve(504);
  context->install(
      [context, visits](double dt) {
        context->advance_hierarchy(dt, [&](double local_dt) {
          const auto point = context->boundary_evaluation_point(0);
          visits->emplace_back(point.level, dt, local_dt);
          auto& stage = context->state(0);
          auto rhs = context->rhs_scratch_like(stage);
          context->rhs_into(0, stage, rhs, 0);
          context->axpy(stage, static_cast<pops::Real>(local_dt), rhs);
        });
      },
      context);
  installed_contexts.insert_or_assign(
      system, ContextControl{context, ControlAccess::generation(*context), {}, visits});
#elif defined(POPS_TEST_MIXED_CFL)
  context->declare_clock_relation(primary_clock, POPS_TEST_EULER_FINE_CLOCK, 1);
  const auto calls = std::make_shared<int>(0);
  context->install([calls](double) { ++*calls; }, context);
  installed_contexts.insert_or_assign(
      system, ContextControl{context, ControlAccess::generation(*context), calls});
#elif defined(POPS_TEST_OWNED_HISTORY)
  context->declare_clock_relation(primary_clock, POPS_TEST_EULER_FINE_CLOCK, history_ratio);
  context->for_each_program_resource_level([&](int) {
    context->register_history(history_name, 1, 1, 0, history_state, std::string(history_space),
                              history_clock, history_interpolation, history_ghost_depth);
  });
#if defined(POPS_TEST_NOOP_HISTORY)
  context->install([](double) {}, context);
#else
  context->install([context](double dt) { context->advance_hierarchy(dt, [](double) {}); },
                   context);
#endif
#else
  pops::test::install_forward_euler_step(context, POPS_TEST_EULER_SOLVE_DEFAULT);
#endif
#if defined(POPS_TEST_OWNED_HISTORY) || defined(POPS_TEST_MIXED_NORM)
  installed_contexts.insert_or_assign(system,
                                      ContextControl{context, ControlAccess::generation(*context)});
#endif
#if defined(POPS_TEST_MIXED_NORM)
  context->declare_clock_relation(primary_clock, POPS_TEST_EULER_FINE_CLOCK, 1);
#elif defined(POPS_TEST_EULER_FINE_CLOCK) && !defined(POPS_TEST_OWNED_HISTORY) && \
    !defined(POPS_TEST_MIXED_CFL) && !defined(POPS_TEST_DECLARED_SUBCYCLING)
  context->declare_clock_relation(primary_clock, POPS_TEST_EULER_FINE_CLOCK, 2);
#endif
}
