#if defined(POPS_TEST_SCALAR_HISTORY)
namespace pops::runtime::program::detail {
template <int Dim>
struct AmrInteractionHistorySnapshotTestAccess {
  using Context = AmrProgramContext<Dim>;
  static bool owns(const Context& context, const pops::AmrSystem<Dim>* system) {
    return context.facade_ == system;
  }
  static std::uint64_t generation(const Context& context) {
    return context.runtime_state().step_install_generation_;
  }
  static bool artifact_backed(const Context& context) {
    return context.runtime_state().artifact_backed_;
  }
};
}  // namespace pops::runtime::program::detail

namespace {
constexpr int dim = pops::kNativeDimension;
using HistorySystem = pops::AmrSystem<dim>;
using HistoryContext = pops::runtime::program::AmrProgramContext<dim>;
using HistoryAccess = pops::runtime::program::detail::AmrInteractionHistorySnapshotTestAccess<dim>;
struct HistoryControl {
  std::weak_ptr<HistoryContext> context;
  std::uint64_t generation;
};
std::unordered_map<HistorySystem*, HistoryControl> histories;
}  // namespace

extern "C" void pops_test_history_context(HistorySystem* system,
                                          std::shared_ptr<HistoryContext>* result) {
  const auto found = histories.find(system);
  if (found == histories.end())
    throw std::logic_error("history control lacks its exact installed system");
  auto context = found->second.context.lock();
  if (!context || !HistoryAccess::owns(*context, system) ||
      HistoryAccess::generation(*context) != found->second.generation ||
      system->installed_program_hash() != pops_program_hash() ||
      !HistoryAccess::artifact_backed(*context))
    throw std::logic_error("history control lost its authenticated installed context");
  *result = std::move(context);
}
#endif

extern "C" void pops_install_program_amr(pops::AmrSystem<pops::kNativeDimension>* system) {
  const auto context = pops::runtime::program::make_program_execution_provider(system);
  context->configure_primary_clock(primary_clock);
#if defined(POPS_TEST_PREPARED_CONSTITUTIVE_AMR)
  pops::test::install_prepared_constitutive_step(context);
#elif defined(POPS_TEST_EMPTY_AMR_CADENCE)
  context->install([](double) {}, context);
#elif defined(POPS_TEST_SCALAR_HISTORY)
  context->declare_clock_relation(primary_clock, POPS_TEST_EULER_FINE_CLOCK, 1);
  context->for_each_program_resource_level([&](int) {
    context->register_history(history_name, 1, 1, 0, history_state, std::string(history_space),
                              history_clock, history_interpolation, POPS_TEST_SCALAR_HISTORY);
  });
  context->install([context](double dt) { context->advance_hierarchy(dt, [](double) {}); },
                   context);
  histories.insert_or_assign(system, HistoryControl{context, HistoryAccess::generation(*context)});
#else
  pops::test::install_forward_euler_step(context, POPS_TEST_EULER_SOLVE_DEFAULT);
#endif
#if defined(POPS_TEST_EULER_FINE_CLOCK) && !defined(POPS_TEST_SCALAR_HISTORY)
  context->declare_clock_relation(primary_clock, POPS_TEST_EULER_FINE_CLOCK, 2);
#endif
}
