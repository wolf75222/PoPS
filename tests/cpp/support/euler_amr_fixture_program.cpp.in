namespace {
constexpr const char* blocks[] = POPS_TEST_EULER_BLOCKS;
constexpr int block_count = int(std::size(blocks));
#if defined(POPS_TEST_PREPARED_CONSTITUTIVE_AMR)
constexpr const char* primary_clock = pops::test::kPreparedConstitutiveAmrClock;
constexpr const char* program_name = "test-prepared-constitutive-amr";
constexpr std::uint64_t flux_bound = 2;
#elif defined(POPS_TEST_EMPTY_AMR_CADENCE)
constexpr const char* primary_clock = "test.clock.macro";
constexpr const char* program_name = "test-empty-amr-cadence";
constexpr std::uint64_t flux_bound = 0;
#elif defined(POPS_TEST_SCALAR_HISTORY)
constexpr const char* primary_clock = "clock.macro";
constexpr const char* program_name = "test-scalar-history-amr";
constexpr std::uint64_t flux_bound = 2;
constexpr const char* history_name = "tracer.potential";
constexpr const char* history_state = "scalar-history:tracer.potential";
constexpr const char* history_clock = "clock.macro";
constexpr const char* history_interpolation = "none";
constexpr auto history_space = pops::runtime::program::kScalarOutputHistorySpace;
#else
constexpr const char* primary_clock = "test.clock.macro";
constexpr const char* program_name = "test-forward-euler-amr";
constexpr std::uint64_t flux_bound = 1;
#endif
constexpr bool block_index(int index) {
  return index >= 0 && index < block_count;
}
}  // namespace

