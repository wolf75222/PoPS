extern "C" void pops_install_program_amr(pops::AmrSystem<pops::kNativeDimension>* system) {
  const auto context = pops::runtime::program::make_program_execution_provider(system);
  context->configure_primary_clock("test.clock.macro");
  pops::test::install_forward_euler_step(context, POPS_TEST_EULER_SOLVE_DEFAULT);
}
