  return "";
}
extern "C" const char* pops_module_operator_requirements(int) {
  return "";
}
extern "C" int pops_module_state_space_count() {
  return block_count;
}
extern "C" const char* pops_module_state_space_name(int block) {
  return block_index(block) ? "U" : "";
}
extern "C" const char* pops_module_state_space_owner(int block) {
