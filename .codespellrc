# Read automatically by codespell when run from the repository root.
# .github/workflows/docs.yml runs advisory spelling checks on pull requests and
# supplies the scope: docs, examples, benchmarks, and the root project guides.
# Exclude generated trees and binary assets from those scans.
[codespell]
skip = ./.git,*/build*,*/_build*,*/_site*,*/doxygen*,*/_generated*,*.png,*.gif,*.svg,*.pdf,*.ico
